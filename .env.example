# MetaTrader 5 Credentials & Account Verification
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-Demo
EXPECTED_MT5_ACCOUNT=12345678
EXPECTED_MT5_SERVER=YourBroker-Demo
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
MT5_TIMEOUT=120000

# Market Data & Strategy Settings
SYMBOL=XAUUSD
TIMEFRAME=M5
MAX_BARS=12000

# Trading Controls & Safety Modes
ENABLE_TRADING=false
ENABLE_ALERTS=true
PAPER_MODE=true
DRY_RUN=true

# Risk Management Settings
MAGIC_NUMBER=26091901
RISK_PERCENT=1.0
MAX_SPREAD=30.0
MAX_POSITIONS=1
MAX_DAILY_LOSS_PERCENT=5.0
MAX_TRADES_PER_DAY=10
MAX_CONSECUTIVE_LOSSES=3

# Default Stop Loss / Take Profit Pips (Fallback)
DEFAULT_SL_PIPS=50.0
DEFAULT_TP_PIPS=150.0

# Strategy Parameters
TAP_SOURCE=TapByWick
ZONE_BODY_PCT=1.0
STOP_ON_TAP=true
ENABLE_ISS=true
STOP_ISS_34_BY_WICK_TAP=true

# Smart Money Concepts (SMC)
SHOW_FVG=false
FVG_DELETE_ON_TAP=true
MAX_FVG=30
SHOW_OB=false
OB_DELETE_ON_TAP=true
MAX_OB=20
SHOW_KZ=false

# System & Logging
DEBUG=true
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=1.0
